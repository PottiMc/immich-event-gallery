# Copy to .env (docker compose) or paste into Portainer under
# Stack -> "Environment variables" -> "Advanced mode", then fill in the values.
# Generate random values e.g. with:  openssl rand -hex 32

# --- Storage on the host (folders are created on first start) ---
# Photos and videos; Immich also writes its daily database dumps here
UPLOAD_LOCATION=/opt/immich-event-gallery/library
# Database - local disk (ideally SSD), never a network share
DB_DATA_LOCATION=/opt/immich-event-gallery/postgres
# Your logos, icons and branding.json (optional; empty = neutral defaults)
BRANDING_LOCATION=/opt/immich-event-gallery/branding

# --- Immich ---
IMMICH_VERSION=v3
# Letters and digits only, no special characters
DB_PASSWORD=CHANGE_ME
TZ=Europe/Berlin

# --- Portal ---
# Public address of the guest portal, without trailing slash
PUBLIC_BASE_URL=https://photos.example.com
# At least 32 characters. Never change it later (printed QR codes would break)
PORTAL_SECRET=CHANGE_ME
PORTAL_ADMIN_PASSWORD=CHANGE_ME
# Created in Immich after the first start (docs/deployment.md, step 4)
IMMICH_API_KEY=
# Proxies allowed to set X-Forwarded-For. Empty = loopback and private
# networks. See docs/configuration.md.
TRUST_PROXY=

# --- E-mail (optional) ---
# Needed for removal requests and the newsletter sign-up. Empty SMTP_HOST =
# no e-mail at all. Brevo e.g.: smtp-relay.brevo.com, port 587.
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none; empty = ssl on port 465, otherwise starttls
SMTP_SECURITY=
SMTP_USER=
SMTP_PASS=
# Sender address, verified with your mail provider; may be "Name <address>"
SMTP_FROM=
# Display name of the sender; empty = the brand name
SMTP_NAME=
# Language of the e-mails to you (en or de); empty = portal default
REMOVAL_REQUEST_LANG=

# --- Removal requests (optional) ---
# Guests can ask for photos to be removed for privacy reasons; the request is
# e-mailed here. Needs the e-mail settings above.
REMOVAL_REQUEST_TO=

# --- Newsletter sign-up (optional) ---
# Switched on in the admin page ("Newsletter"). Gets an e-mail per confirmed
# sign-up; empty = the SMTP_FROM address.
NEWSLETTER_NOTIFY=
# Your Immich web UI, so the e-mail links straight to each photo
IMMICH_ADMIN_URL=

# --- Host ports (change only if taken) ---
# Address the ports listen on. 0.0.0.0 = all interfaces (the whole LAN).
# Safer: only where your reverse proxy / tunnel connects from, e.g. 127.0.0.1.
BIND_IP=0.0.0.0
IMMICH_HOST_PORT=2284
PORTAL_HOST_PORT=3100
ADMIN_HOST_PORT=3101

# --- CPU limits (cores per container) ---
# Keep a request flood or a big import from slowing down the whole host.
# Never set more than the host has (nproc). Empty = the defaults below.
PORTAL_CPUS=1
IMMICH_CPUS=2
ML_CPUS=2

# --- Portal image ---
PORTAL_IMAGE=ghcr.io/pottimc/immich-event-gallery:latest

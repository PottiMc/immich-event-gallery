{
  "name": "immich-event-gallery",
  "version": "3.4.0",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"tsx watch src/index.ts\" \"tsc -w -p tsconfig.client.json\"",
    "build": "tsc && tsc -p tsconfig.client.json",
    "build:server": "tsc",
    "build:client": "tsc -p tsconfig.client.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:container": "podman build --build-arg PACKAGE_VERSION=$(npm pkg get version | xargs) --format docker -t immich-proxy-test .. && podman run --init -it -p=3000:3000 --env-file .env --restart=always immich-proxy-test",
    "start": "node dist/index.js"
  },
  "author": "Alan Grainger",
  "license": "AGPL-3.0",
  "description": "Password-based photo portal for Immich shares (fork of Immich Public Proxy)",
  "repository": {
    "type": "git",
    "url": "https://github.com/PottiMc/immich-event-gallery.git"
  },
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "dependencies": {
    "archiver": "^7.0.1",
    "cookie-session": "^2.1.0",
    "dayjs": "^1.11.23",
    "dotenv": "^16.6.1",
    "express": "^4.21.1",
    "nodemailer": "^10.0.12",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "qrcode": "^1.5.4",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^4.17.21",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "concurrently": "^10.0.3",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "photoswipe": "^5.4.4",
    "tsx": "^4",
    "typescript": "^5.9.3",
    "vitest": "^4"
  }
}
